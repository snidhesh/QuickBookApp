# From developer.intuit.com > your app > Keys & credentials
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# sandbox or production (production needs the app's Production keys)
QBO_ENVIRONMENT=sandbox
# Must exactly match a Redirect URI listed on the app's Keys & credentials page.
# On Vercel it defaults to https://<production domain>/callback
QBO_REDIRECT_URI=http://localhost:5055/callback

# Password people enter to use the app. Required on Vercel; optional locally.
APP_PASSWORD=

# Local only
PORT=5055
HOST=127.0.0.1

# Set automatically on Vercel when Upstash for Redis is added to the project.
# Leave empty locally to store data in data/store.json instead.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
